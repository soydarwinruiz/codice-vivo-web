{
  "name": "codice-vivo",
  "version": "1.0.0",
  "description": "Códice vivo — Biblia de estudio 100% local (web para iPhone y escritorio para Windows)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "desktop:build-ui": "vite build --mode desktop",
    "desktop": "npm run desktop:build-ui && electron .",
    "desktop:dev": "node electron/dev.mjs",
    "dist:win": "npm run desktop:build-ui && electron-builder --win --x64 --publish never"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soydarwinruiz/codice-vivo-web.git"
  },
  "keywords": [],
  "author": "Darwin Ruiz",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/soydarwinruiz/codice-vivo-web/issues"
  },
  "homepage": "https://github.com/soydarwinruiz/codice-vivo-web#readme",
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "preact": "^11.2.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0"
  },
  "type": "module",
  "private": true,
  "productName": "Códice vivo",
  "build": {
    "appId": "io.github.soydarwinruiz.codicevivo",
    "productName": "Códice vivo",
    "executableName": "CodiceVivo",
    "copyright": "Códice vivo",
    "directories": {
      "output": "release",
      "buildResources": "electron"
    },
    "files": [
      "electron/**",
      "dist-desktop/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png",
      "artifactName": "CodiceVivo-${version}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Códice vivo",
      "installerLanguages": [
        "es_ES"
      ],
      "language": "3082",
      "artifactName": "CodiceVivo-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "CodiceVivo-Portable-${version}.${ext}"
    }
  }
}
